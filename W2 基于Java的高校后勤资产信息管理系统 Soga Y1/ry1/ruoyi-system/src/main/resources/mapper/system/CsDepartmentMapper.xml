<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.CsDepartmentMapper">
    
    <resultMap type="CsDepartment" id="CsDepartmentResult">
        <result property="id"    column="id"    />
        <result property="name"    column="name"    />
        <result property="location"    column="location"    />
    </resultMap>

    <sql id="selectCsDepartmentVo">
        select id, name, location from cs_department
    </sql>

    <select id="selectCsDepartmentList" parameterType="CsDepartment" resultMap="CsDepartmentResult">
        <include refid="selectCsDepartmentVo"/>
        <where>  
            <if test="name != null  and name != ''"> and name like concat('%', #{name}, '%')</if>
            <if test="location != null  and location != ''"> and location = #{location}</if>
        </where>
    </select>
    
    <select id="selectCsDepartmentById" parameterType="Long" resultMap="CsDepartmentResult">
        <include refid="selectCsDepartmentVo"/>
        where id = #{id}
    </select>
        
    <insert id="insertCsDepartment" parameterType="CsDepartment" useGeneratedKeys="true" keyProperty="id">
        insert into cs_department
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="name != null and name != ''">name,</if>
            <if test="location != null">location,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="name != null and name != ''">#{name},</if>
            <if test="location != null">#{location},</if>
         </trim>
    </insert>

    <update id="updateCsDepartment" parameterType="CsDepartment">
        update cs_department
        <trim prefix="SET" suffixOverrides=",">
            <if test="name != null and name != ''">name = #{name},</if>
            <if test="location != null">location = #{location},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteCsDepartmentById" parameterType="Long">
        delete from cs_department where id = #{id}
    </delete>

    <delete id="deleteCsDepartmentByIds" parameterType="String">
        delete from cs_department where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

</mapper>